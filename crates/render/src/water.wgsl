struct Params{view_projection:mat4x4<f32>,inverse_view_projection:mat4x4<f32>,eye_time:vec4<f32>,absorption:vec4<f32>,scattering:vec4<f32>,optics:vec4<f32>,sun:vec4<f32>,image:vec4<u32>,quality:vec4<u32>,waves:vec4<f32>};
struct Object{model:mat4x4<f32>,metadata:vec4<u32>};
@group(0)@binding(0)var<uniform>params:Params;
@group(0)@binding(1)var<storage,read>objects:array<Object>;
@group(0)@binding(2)var<storage,read>quads:array<vec4<u32>>;
@group(0)@binding(3)var<storage,read>visible:array<u32>;
@group(0)@binding(4)var sky_view:texture_2d<f32>;
@group(0)@binding(5)var opaque_snapshot:texture_2d<f32>;
@group(0)@binding(6)var opaque_depth:texture_depth_multisampled_2d;
@group(0)@binding(7)var transmittance:texture_2d<f32>;
@group(0)@binding(12)var opaque_color:texture_multisampled_2d<f32>;
// SHADOWS
// STATS
fn lookup(tex:texture_2d<f32>,uv:vec2<f32>)->vec3<f32>{let dimensions=vec2<i32>(textureDimensions(tex));let p=uv*vec2<f32>(dimensions)-vec2(0.5);let low=vec2<i32>(floor(p));let fraction=fract(p);var color=vec3(0.);for(var c=0u;c<4u;c++){let d=vec2<i32>(i32(c&1u),i32(c>>1u));let w=select(vec2(1.)-fraction,fraction,d!=vec2(0));color+=textureLoad(tex,clamp(low+d,vec2(0),dimensions-vec2(1)),0).rgb*w.x*w.y;}return color;}
fn radiance(uv:vec2<f32>,sample:i32)->vec3<f32>{let dimensions=vec2<i32>(params.image.xy);let p=uv*vec2<f32>(dimensions)-vec2(0.5);let low=vec2<i32>(floor(p));let fraction=fract(p);var color=vec3(0.);for(var c=0u;c<4u;c++){let d=vec2<i32>(i32(c&1u),i32(c>>1u));let w=select(vec2(1.)-fraction,fraction,d!=vec2(0));color+=textureLoad(opaque_color,clamp(low+d,vec2(0),dimensions-vec2(1)),sample).rgb*w.x*w.y;}return color;}
fn environment(direction:vec3<f32>)->vec3<f32>{let uv=vec2(atan2(direction.z,direction.x)/6.28318530718+0.5,direction.y*0.5+0.5);return lookup(sky_view,uv);}
fn project(p:vec3<f32>)->vec3<f32>{let clip=params.view_projection*vec4(p,1.);let ndc=clip.xyz/clip.w;return vec3(ndc.x*0.5+0.5,0.5-ndc.y*0.5,ndc.z);}
fn unproject(uv:vec2<f32>,depth:f32)->vec3<f32>{let p=params.inverse_view_projection*vec4(uv.x*2.-1.,1.-uv.y*2.,depth,1.);return p.xyz/p.w;}
fn depth_at(uv:vec2<f32>,sample:i32)->f32{let p=clamp(vec2<i32>(uv*vec2<f32>(params.image.xy)),vec2(0),vec2<i32>(params.image.xy)-vec2(1));return textureLoad(opaque_depth,p,sample);}
fn fresnel(cosine:f32,underwater:bool)->f32{let ni=select(1.,params.optics.x,underwater);let nt=select(params.optics.x,1.,underwater);let sine2=(ni/nt)*(ni/nt)*max(0.,1.-cosine*cosine);if sine2>=1.{return 1.;}let transmitted=sqrt(1.-sine2);let rs=(ni*cosine-nt*transmitted)/max(ni*cosine+nt*transmitted,0.000001);let rp=(ni*transmitted-nt*cosine)/max(ni*transmitted+nt*cosine,0.000001);return (rs*rs+rp*rp)*0.5;}
struct Out{@builtin(position)position:vec4<f32>,@location(1)normal:vec3<f32>,@location(2)@interpolate(flat)tint:vec3<f32>,@location(3)@interpolate(flat)flow:vec2<f32>,@location(4)@interpolate(flat)foam:f32};
@vertex fn vertex(@builtin(vertex_index)vi:u32,@builtin(instance_index)ii:u32)->Out{
 let q=quads[visible[ii]];let object=objects[q.w&65535u];let c=vi&3u;let origin=vec3<f32>(f32(q.x&31u),f32((q.x>>5u)&31u),f32((q.x>>10u)&31u));let face=(q.x>>15u)&7u;let width=f32(((q.x>>18u)&15u)+1u);let height=f32(((q.x>>22u)&15u)+1u);let tu=array<vec3<f32>,6>(vec3(1.,0.,0.),vec3(1.,0.,0.),vec3(-1.,0.,0.),vec3(1.,0.,0.),vec3(0.,0.,1.),vec3(0.,0.,-1.));let tv=array<vec3<f32>,6>(vec3(0.,0.,1.),vec3(0.,0.,-1.),vec3(0.,1.,0.),vec3(0.,1.,0.),vec3(0.,1.,0.),vec3(0.,1.,0.));let normals=array<vec3<f32>,6>(vec3(0.,-1.,0.),vec3(0.,1.,0.),vec3(0.,0.,-1.),vec3(0.,0.,1.),vec3(-1.,0.,0.),vec3(1.,0.,0.));var local=origin+tu[face]*(f32(c&1u)*width)+tv[face]*(f32(c>>1u)*height);let level=f32((q.y>>(c*8u))&255u)/255.;if face==1u||(face>=2u&&(c&2u)!=0u){local.y+=level-1.;}var world=(object.model*vec4(local,1.)).xyz;let phase_x=world.x*params.waves.y+params.eye_time.w*params.waves.w;let phase_z=world.z*params.waves.z-params.eye_time.w*params.waves.w*0.8;var normal=normalize((object.model*vec4(normals[face],0.)).xyz);if face==1u{world.y+=params.waves.x*(sin(phase_x)+0.5*sin(phase_z));normal=normalize(vec3(-params.waves.x*params.waves.y*cos(phase_x),1.,-0.5*params.waves.x*params.waves.z*cos(phase_z)));}var out:Out;out.position=params.view_projection*vec4(world,1.);out.normal=normal;let tint=vec3<f32>(f32(q.z&255u),f32((q.z>>8u)&255u),f32((q.z>>16u)&255u))/255.;out.tint=tint*tint;out.foam=f32(q.z>>24u)/255.;let fx=bitcast<i32>(((q.w>>16u)&255u)<<24u)>>24;let fz=bitcast<i32>((q.w>>24u)<<24u)>>24;out.flow=vec2<f32>(f32(fx),f32(fz))/127.;return out;
}
@vertex fn background_vertex(@builtin(vertex_index)index:u32)->@builtin(position)vec4<f32>{let p=array<vec2<f32>,3>(vec2(-1.,-1.),vec2(3.,-1.),vec2(-1.,3.));return vec4(p[index],0.,1.);}
struct Background{@location(0)color:vec4<f32>,@builtin(frag_depth)depth:f32};
fn background_shade(p:vec4<f32>,sample:u32)->Background{let pixel=clamp(vec2<i32>(p.xy),vec2(0),vec2<i32>(params.image.xy)-vec2(1));var out:Background;out.color=textureLoad(opaque_color,pixel,i32(sample));out.depth=textureLoad(opaque_depth,pixel,i32(sample));if params.quality.y!=0u{let uv=p.xy/vec2<f32>(params.image.xy);var t=vec3(0.);if out.depth>0.{let point=unproject(uv,out.depth);t=exp(-(params.absorption.rgb+vec3(params.absorption.a))*min(distance(point,params.eye_time.xyz),params.optics.z));}let source=params.scattering.rgb*environment(vec3(0.,1.,0.));out.color=vec4(t*out.color.rgb+(vec3(1.)-t)*source,out.color.a);}return out;}
// Reconstruct the exact covered sample. Perspective varyings of clipped large
// quads can disagree near the critical angle; sample depth stays authoritative.
struct Shaded{@location(0)color:vec4<f32>,@location(1)normal_foam:vec4<f32>};
fn shade(input:Out,sample:u32)->Shaded{
 let uv=input.position.xy/vec2<f32>(params.image.xy);let world=unproject(uv,input.position.z);let view=normalize(params.eye_time.xyz-world);var normal=normalize(input.normal);if dot(normal,view)<0.{normal=-normal;}let cosine=clamp(dot(normal,view),0.0001,1.);let underwater=params.quality.y!=0u;let f=fresnel(cosine,underwater);let sigma=params.absorption.rgb+vec3(params.absorption.a);let opaque=depth_at(uv,i32(sample));var thickness=params.optics.z;var known_bottom=false;if opaque>0.{let bottom=unproject(uv,opaque);if distance(bottom,params.eye_time.xyz)>distance(world,params.eye_time.xyz){thickness=min(distance(bottom,world),params.optics.z);known_bottom=true;}}
 let eta=select(1./params.optics.x,params.optics.x,underwater);let refracted=refract(-view,normal,eta);var refract_uv=uv;if known_bottom&&f<1.{let projected=project(world+refracted*thickness);if projected.z>=0.&&projected.z<=1.{refract_uv=mix(uv,clamp(projected.xy,vec2(0.),vec2(1.)),clamp(params.optics.w*50.,0.,1.));}}let refract_depth=depth_at(refract_uv,i32(sample));if refract_depth>0.{let bottom=unproject(refract_uv,refract_depth);if distance(bottom,params.eye_time.xyz)>distance(world,params.eye_time.xyz){thickness=min(distance(bottom,world),params.optics.z);known_bottom=true;}else{refract_uv=uv;}}else{known_bottom=false;}
 let trans=select(vec3(0.),exp(-sigma*thickness),known_bottom);let reflection=reflect(-view,normal);var reflected=environment(reflection);let hit=false;record(0u,false);let ambient=environment(vec3(0.,1.,0.));let source=params.scattering.rgb*ambient;if underwater&&!hit{reflected=source;}let transmitted=radiance(refract_uv,i32(sample));var caustic=1.;if known_bottom&&params.sun.w>0.{let curvature=params.waves.x*(params.waves.y*params.waves.y*sin(world.x*params.waves.y+params.eye_time.w*params.waves.w)+0.5*params.waves.z*params.waves.z*sin(world.z*params.waves.z-params.eye_time.w*params.waves.w*0.8));caustic=clamp(1./max(0.5,1.+curvature*thickness*0.05),0.7,1.5);}var color=(1.-f)*(trans*transmitted*caustic+(vec3(1.)-trans)*source)*input.tint+f*reflected;if underwater{var outside=transmitted;if refract_depth<=0.{outside=environment(refracted);}color=(1.-f)*outside*input.tint+f*reflected;}
 let sun=normalize(params.sun.xyz);let nl=max(dot(normal,sun),0.);if nl>0.&&params.sun.w>0.{let halfway=normalize(view+sun);let nh=max(dot(normal,halfway),0.);let alpha=params.optics.y*params.optics.y;let a2=alpha*alpha;let denominator=nh*nh*(a2-1.)+1.;let distribution=a2/(3.14159265359*denominator*denominator);let k=(params.optics.y+1.)*(params.optics.y+1.)/8.;let g=cosine/(cosine*(1.-k)+k)*nl/(nl*(1.-k)+k);let light=lookup(transmittance,vec2(sun.y*0.5+0.5,clamp(world.y/100000.,0.,1.)))*params.sun.w;color+=light*f*distribution*g/max(4.*cosine,0.0001)*cascade_shadow(world,normal);}
 let shore=select(0.,1.-clamp(thickness*0.4,0.,1.),known_bottom);let foam=clamp(input.foam+shore*length(input.flow)*0.4,0.,1.);color=mix(color,ambient*0.8,foam);if underwater{let medium=exp(-sigma*min(distance(world,params.eye_time.xyz),params.optics.z));color=medium*color+(vec3(1.)-medium)*source;}return Shaded(vec4(max(color,vec3(0.)),1.),vec4(normal,foam));
}

@fragment fn fragment(input:Out,@builtin(sample_index)sample:u32)->@location(0)vec4<f32>{return shade(input,sample).color;}
@fragment fn fragment_with_normal(input:Out,@builtin(sample_index)sample:u32)->Shaded{return shade(input,sample);}
@fragment fn background_fragment(@builtin(position)p:vec4<f32>,@builtin(sample_index)sample:u32)->Background{return background_shade(p,sample);}
struct BackgroundNormals{@location(0)color:vec4<f32>,@location(1)normal_foam:vec4<f32>,@builtin(frag_depth)depth:f32};
@fragment fn background_fragment_with_normal(@builtin(position)p:vec4<f32>,@builtin(sample_index)sample:u32)->BackgroundNormals{let b=background_shade(p,sample);return BackgroundNormals(b.color,vec4(0.),b.depth);}
